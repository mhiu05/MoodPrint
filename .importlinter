[importlinter]
root_packages =
    safevoice_shared
    safevoice_agent
    app
include_external_packages = True

[importlinter:contract:shared]
name = Shared cannot depend on application packages
type = forbidden
source_modules = safevoice_shared
forbidden_modules =
    safevoice_agent
    app

[importlinter:contract:agent]
name = Agent cannot depend on backend infrastructure
type = forbidden
source_modules = safevoice_agent
forbidden_modules =
    app
    fastapi

[importlinter:contract:routers]
name = Routers use services rather than privileged gateways
type = forbidden
source_modules = app.api
forbidden_modules = app.infrastructure
