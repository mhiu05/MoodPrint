          "none",
          "elevated",
          "immediate"
        ],
        "title": "Urgency",
        "type": "string"
      },
      "userReportedFacts": {
        "items": {
          "$ref": "#/$defs/Finding"
        },
        "title": "Userreportedfacts",
        "type": "array"
      }
    },
    "required": [
      "reply"
    ],
    "title": "CompanionTurn",
    "type": "object"
