    "title": "Finding",
    "type": "object"
  },
  "SafeOption": {
    "additionalProperties": false,
    "properties": {
      "description": {
        "default": "",
        "title": "Description",
        "type": "string"
      },
      "label": {
        "title": "Label",
        "type": "string"
      }
    },
    "required": [
      "label"
    ],
    "title": "SafeOption",
    "type": "object"
  },
