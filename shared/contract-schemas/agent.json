{
  "CompanionTurn": {
    "$defs": {
      "Finding": {
        "additionalProperties": false,
        "properties": {
          "sourceIds": {
            "items": {
              "type": "string"
            },
            "title": "Sourceids",
            "type": "array"
          },
          "text": {
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "text"
        ],
        "title": "Finding",
        "type": "object"
      },
      "SafeOption": {
        "additionalProperties": false,
        "properties": {
          "description": {
            "default": "",
