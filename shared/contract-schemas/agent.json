            "type": "string"
          },
          "countryScope": {
            "items": {
              "type": "string"
            },
            "title": "Countryscope",
            "type": "array"
          },
          "documentId": {
            "title": "Documentid",
            "type": "string"
          },
          "lastReviewed": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Lastreviewed"
          },
          "publishedAt": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Publishedat"
          },
          "publisher": {
            "title": "Publisher",
            "type": "string"
          },
          "section": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Section"
          },
          "sourceId": {
            "title": "Sourceid",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "url": {
            "anyOf": [
              {
                "format": "uri",
                "maxLength": 2083,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Url"
          }
        },
        "required": [
          "sourceId",
          "documentId",
          "title",
          "publisher",
          "url",
          "section",
          "publishedAt",
          "lastReviewed",
          "applicability",
          "countryScope"
