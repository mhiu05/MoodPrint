# Nội dung mẫu cho SecureString /moodprint/staging/runtime. Không điền bí mật vào Git.
APP_ENV=production
DATABASE_URL=
DATABASE_POOL_MODE=session
# Candidate API5 + proactive2 + maps1, doubled during overlap =16; reserve4.
# Verify actual role/pooler/server capacity before production activation.
DATABASE_POOL_SIZE=4
DATABASE_POOL_OVERFLOW=1
DATABASE_POOL_TIMEOUT=10
# Candidate SET LOCAL bounds before registered row locks; benchmark before approval.
DATABASE_TRANSACTION_TIMEOUTS_ENABLED=false
DATABASE_STATEMENT_TIMEOUT_MS=15000
DATABASE_LOCK_TIMEOUT_MS=2000
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
FRONTEND_ORIGIN=https://staging.example.org
COOKIE_SECURE=true
# Match Supabase Authentication CAPTCHA protection; uses GUEST_CAPTCHA_SITE_KEY below.
AUTH_CAPTCHA_ENABLED=false
# Candidate NAT policy:150/action/60s,600 aggregate/900s; email3/h,login10/900s unchanged.
# Requires CAPTCHA; leave false until the exact production policy is approved.
AUTH_NAT_POLICY_ENABLED=false
# AI_ENABLED: mặc định true; đặt false để tắt.
# AI_MULTI_MESSAGE_ENABLED: mặc định true; đặt false để tắt.
# AI_THREE_AGENT_EXPERIENCE_ENABLED: mặc định true; đặt false để tắt.
# AI_SMART_ORCHESTRATION_ENABLED: mặc định true; đặt false để tắt.
# AI_GROUP_CHAT_ENABLED: mặc định true; đặt false để tắt.
AI_V3_ROLLOUT_USER_IDS=[]
# AI_COLLABORATION_ENABLED: mặc định true; đặt false để tắt.
AI_COLLABORATION_ROLLOUT_USER_IDS=[]
# AI_COLLABORATION_DEFAULTS_ENABLED: mặc định true; đặt false để tắt.
AI_COLLABORATION_POLICY_EPOCH=2
# PROACTIVE_ENABLED: mặc định true; đặt false để tắt.
# PROACTIVE_WORKER_ENABLED: mặc định true; đặt false để tắt.
PROACTIVE_ROLLOUT_USER_IDS=[]
# AI_AGENT_SKILLS_ENABLED: mặc định true; đặt false để tắt.
# AI_WEB_SEARCH_ENABLED: mặc định true; đặt false để tắt.
# AI_MAPS_SEARCH_ENABLED: mặc định true; đặt false để tắt.
AI_SEARCH_ROLLOUT_USER_IDS=[]
AI_SEARCH_DAILY_CAP_PER_USER=5
AI_SEARCH_USER_CONCURRENCY=1
AI_SEARCH_GLOBAL_CONCURRENCY=2
AI_SEARCH_DAILY_BUDGET_USD=5
# Server-only; put real token in the existing SecureString, never in Git.
APIFY_API_TOKEN=
APIFY_MAPS_ACTOR_BUILD=
APIFY_MAPS_PRICING_VERSION=
APIFY_MAPS_CHARGE_BOUND_VERIFIED=false
# MAPS_SEARCH_WORKER_ENABLED: mặc định true; đặt false để tắt.
AI_WEB_SEARCH_PRICING_VERSION=
AI_WEB_SEARCH_TOKEN_BOUND_VERIFIED=false
OPENAI_API_KEY=
OPENAI_MODEL=
# AI_ACCOUNTING_ENABLED: mặc định true; đặt false để tắt.
# STT_ENABLED: mặc định true; đặt false để tắt.
# Xác minh model thật trước khi bật; gpt-transcribe chưa được xác nhận trong tài liệu API hiện tại.
STT_MODEL=
# SEMANTIC_MEMORY_ENABLED: mặc định true; đặt false để tắt.
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-4-lite
VOYAGE_DIMENSIONS=1024
# CHAT_HISTORY_ENABLED: mặc định true; đặt false để tắt.
# SANDBOX_ENABLED: mặc định true; đặt false để tắt.
# v1 | v2 | shadow; see docs/productization/evidence/matching-gate.md
MATCHING_SCORER=v1
# Shared activities; enable after 0013 is applied (staging first).
# ACTIVITIES_ENABLED: mặc định true; đặt false để tắt.
ACTIVITY_KINDS=["icebreaker","coop_quiz","focus"]
# Required for a real-user beta (moderation is a launch blocker).
# MODERATION_ADMIN_ENABLED: mặc định true; đặt false để tắt.
# Set both before inviting real users (release gate G9).
AI_DAILY_TURNS_PER_USER=60
# Approved target; updating this example does not activate a hosted budget.
AI_DAILY_BUDGET_USD=50
# Candidate one API50 + one proactive2 physical model-call slots (total52), finite queue100.
# Approval/deployment topology and actual provider quotas required before activation.
AI_DISPATCH_GATE_ENABLED=false
AI_DISPATCH_QUEUE_LIMIT=100
# Candidate:3 calls/row,64k exact input/call,1200 output/call,$0.12 hold/row.
# Adds an exact-count HTTP preflight before EACH generation. Overlong contexts are rejected,
# never truncated. Hosted tools/stateful/file inputs fail closed. Keep false pending
# account/model/count-endpoint pricing+quota and UX approval; legacy$2 holds remain supported.
AI_BOUNDED_RESERVATIONS_ENABLED=false
# Guest trial, feedback and tour rollout. Feature flags default on; availability still requires configuration. Turning entry off never
# disables guest expiry, cleanup, orphan reconciliation or spend settlement.
# GUEST_AUTH_ENABLED: mặc định true; đặt false để tắt.
# GUEST_PAID_ENABLED: mặc định true; đặt false để tắt.
# GUEST_SEMANTIC_ENABLED: mặc định true; đặt false để tắt.
# FEEDBACK_ENABLED: mặc định true; đặt false để tắt.
# FEEDBACK_ADMIN_ENABLED: mặc định true; đặt false để tắt.
# PRODUCT_TOUR_ENABLED: mặc định true; đặt false để tắt.
# Feedback collection also needs GUEST_ABUSE_HMAC_KEY. RELEASE_VERSION is the server-stamped
# deployment revision recorded on each feedback row (<= 64 chars: letters, digits . _ + -).
RELEASE_VERSION=unknown
# Paid guest AI needs verified model prices and a positive subset budget <=5 USD inside the
# global AI_DAILY_BUDGET_USD cap <=50 USD. Unset/zero keeps paid guest work closed.
# Voice/embedding remain unavailable in the capped demo configuration.
GUEST_DAILY_BUDGET_USD=
GUEST_PRICING_JSON={}
# At least 32 random characters, set only as a secret in the real environment; never committed.
GUEST_ABUSE_HMAC_KEY=
# Public site key of the CAPTCHA configured in the Auth provider; required before guest entry.
GUEST_CAPTCHA_SITE_KEY=
# Keep the HMAC key stable;
# rotation requires entry/collection off and a reviewed >=24h counter/attempt drain.
# Rollback must remain guest-aware at schema 0018; flags off never stop cleanup.
GUEST_AI_TURNS=50
GUEST_AI_PER_MINUTE=6
GUEST_AI_CONCURRENCY=1
GUEST_AI_GLOBAL_CONCURRENCY=10
GUEST_VOICE_CLIPS=20
GUEST_VOICE_SECONDS=600
GUEST_VOICE_PER_MINUTE=2
GUEST_VOICE_CONCURRENCY=1
GUEST_VOICE_GLOBAL_CONCURRENCY=3
AI_LOCAL_TEST_USER_IDS=[]

# JOURNAL_SEMANTIC_ENABLED: mặc định true; đặt false để tắt.

# JOURNAL_AUTO_MEMORY_ENABLED: mặc định true; đặt false để tắt.
