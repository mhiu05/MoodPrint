{
  "name": "moodprint-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run && node --require ./scripts/redocly-minimatch.cjs --test ./scripts/redocly-minimatch.test.cjs",
    "test:e2e": "playwright test",
    "test:e2e:fullstack": "playwright test --config playwright.fullstack.config.ts",
    "contracts:generate": "node --require ./scripts/redocly-minimatch.cjs ./node_modules/openapi-typescript/bin/cli.js ../backend/openapi.json -o src/api/generated/schema.d.ts"
  },
  "overrides": {
    "@redocly/openapi-core": {
      "minimatch": "11.0.1"
    }
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "gsap": "^3.13.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "10.1.0",
    "react-router-dom": "^7.9.4",
    "thinking-orbs": "0.3.2",
    "tus-js-client": "^4.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.56.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "agent-browser": "0.39.4",
    "openapi-typescript": "7.13.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "vite": "^7.1.10",
    "vitest": "5.0.5"
  }
}
