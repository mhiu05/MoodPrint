# MoodPrint — root environment template
#
# Copy to `.env` (same folder) and fill in real values. `.env` is gitignored.
# This file holds placeholders only. Never put a real key here.
#
# Rules
# - Secrets live only in `.env`.
# - Non-secret tuning (models, timeouts, limits, top-k...) lives in
#   shared/src/moodprint_shared/config.py, NOT here.
# - Only variables prefixed `VITE_PUBLIC_` reach the browser bundle
#   (vite.config.ts: envDir="..", envPrefix="VITE_PUBLIC_").
# - APP_ENV=test never reads this file; tests use a local Supabase stack.

# --- runtime -----------------------------------------------------------------
# development | test | production
APP_ENV=development
# Comma-separated browser origins allowed by FastAPI CORS (no wildcard).
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:5178

# --- supabase: public -----------------------------------------------------------
# Dashboard > Project Settings > API. Format: https://<project-ref>.supabase.co
SUPABASE_URL=https://<project-ref>.supabase.co
# Publishable key (sb_publishable_...). Safe for the browser, but keep it in .env.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_<placeholder>

# --- supabase: secret (backend only) ---------------------------------------------
# Secret key (sb_secret_...). Used only by app/infrastructure (Storage, Auth admin).
SUPABASE_SECRET_KEY=sb_secret_<placeholder>

# Runtime DB connection as the restricted login role `moodprint_api`.
# The coding agent generates this password and fills this line itself
# (scripts/db/set_api_role_password.py); you do not need to fill it.
# Dashboard > Connect > Session pooler, then replace user and password.
DATABASE_URL=postgresql+asyncpg://moodprint_api.<project-ref>:<generated-password>@aws-<region>.pooler.supabase.com:5432/postgres

# Privileged connection for migrations only (role `postgres`).
# Dashboard > Connect > Session pooler. Use the database password you set when
# creating the project. Used by `supabase db push --db-url`, never by the app.
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<database-password>@aws-<region>.pooler.supabase.com:5432/postgres

# --- frontend (exposed to the browser) ---------------------------------------
VITE_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<placeholder>
VITE_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# --- agent ---------------------------------------------------------------------
# Required for live agent runs and `pytest -m live_agent`. Offline tests use
# ScriptedModel and do not need it.
OPENAI_API_KEY=sk-<placeholder>

# --- knowledge -----------------------------------------------------------------
# Phase 2 embeddings. Not needed for Phase 0/1.
VOYAGE_API_KEY=<placeholder>

# --- future integrations ---------------------------------------------------------
# Not used in Phase 0/1. Keep empty until a phase needs it.
APIFY_API_TOKEN=
