{
  "schema": 1,
  "plugins": {
    "marketplaces": {
      "promptfoo": { "source": "github", "repo": "promptfoo/promptfoo" },
      "openai-developers": { "source": "github", "repo": "openai/openai-developers-for-claude" }
    },
    "install": [
      "superpowers@anthropic-plugin-directory",
      "promptfoo@promptfoo",
      "openai-developers@openai-developers"
    ],
    "scope": "project"
  },
  "cli": {
    "agent-browser": { "npm": "agent-browser", "version": "0.39.4" },
    "promptfoo": { "npm": "promptfoo", "version": "0.125.1" },
    "deepeval": { "pypi": "deepeval", "version": "4.3.1", "python": "3.12" },
    "impeccable": { "npm": "impeccable", "version": "4.7.0", "installArgs": "install --providers=claude --scope=project -y" },
    "ui-ux-pro-max": { "npm": "ui-ux-pro-max-cli", "version": "2.15.0", "installArgs": "init --ai claude --offline" }
  },
  "skills": {
    "agent-browser": { "installer": "skills", "source": "vercel-labs/agent-browser", "skill": "agent-browser" },
    "deepeval": { "installer": "skills", "source": "confident-ai/deepeval", "skill": "deepeval" },
    "supabase": { "installer": "skills", "source": "supabase/agent-skills", "skill": "supabase" },
    "supabase-postgres-best-practices": { "installer": "skills", "source": "supabase/agent-skills", "skill": "supabase-postgres-best-practices" },
    "vercel-composition-patterns": { "installer": "skills", "source": "vercel-labs/agent-skills", "skill": "vercel-composition-patterns" },
    "vercel-react-best-practices": { "installer": "skills", "source": "vercel-labs/agent-skills", "skill": "vercel-react-best-practices" },
    "web-design-guidelines": { "installer": "skills", "source": "vercel-labs/agent-skills", "skill": "web-design-guidelines" },
    "impeccable": { "installer": "cli", "cli": "impeccable" },
    "ui-ux-pro-max": { "installer": "cli", "cli": "ui-ux-pro-max", "removeExtras": ["banner-design", "brand", "design", "design-system", "slides", "ui-styling"] }
  },
  "mcpServers": ["supabase", "promptfoo"]
}
