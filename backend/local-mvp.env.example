# Safe LOCAL example. Copy to backend/.env only if it does not already exist.
# Existing user-owned .env files must be edited deliberately, never overwritten.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://postgres:moodprint-local-only@127.0.0.1:55432/moodprint_local_mvp_test
DATABASE_MIGRATION_URL=postgresql+psycopg://postgres:moodprint-local-only@127.0.0.1:55432/moodprint_local_mvp_test
DATABASE_POOL_MODE=direct
FRONTEND_ORIGIN=http://127.0.0.1:5173
COOKIE_SECURE=false
# Normal application auth requires a separate local HTTPS Supabase Auth setup
# sharing this database's auth.sessions. A hosted Auth URL alone is not sufficient.
# Offline browser verification uses tests/e2e_server.py, never a production bypass.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Both values are REQUIRED; use a model enabled for your OpenAI project that
# supports Responses API structured output and function tools. No fake fallback.
OPENAI_API_KEY=
OPENAI_MODEL=
AI_ENABLED=true
CHAT_HISTORY_ENABLED=true
CHAT_RETENTION_DAYS=30
AI_ACCOUNTING_ENABLED=false
# Admission limits remain active even with accounting off.
AI_DAILY_TURNS_PER_USER=60
AI_REQUESTS_PER_MINUTE=20
AI_USER_CONCURRENCY=2
AI_GLOBAL_CONCURRENCY=50
ACTIVITIES_ENABLED=true
MATCHING_SCORER=v2
# Approved memories work without external embeddings. Enable only after supplying
# Voyage credentials AND explicit per-user external processing consent.
SEMANTIC_MEMORY_ENABLED=false
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-4-lite
VOYAGE_DIMENSIONS=1024
STT_ENABLED=false
SANDBOX_ENABLED=false
