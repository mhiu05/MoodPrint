APP_ENV=development
# Copy the PostgreSQL URL from Supabase Connect. Runtime must not be a superuser.
DATABASE_URL=
# Direct or session pooler; never use transaction pooler for Alembic.
DATABASE_MIGRATION_URL=
DATABASE_POOL_MODE=session
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
FRONTEND_ORIGIN=http://127.0.0.1:5173
COOKIE_SECURE=false
OPENAI_API_KEY=
OPENAI_MODEL=
# Requires a reviewed provider retention policy before allowing private data.
AI_ENABLED=false
# Development only: JSON array of internal application user IDs. Normal auth/consent still apply.
AI_LOCAL_TEST_USER_IDS=[]
# Enable only after 0006_ai_usage is applied to the selected database.
AI_ACCOUNTING_ENABLED=false
STT_ENABLED=false
STT_MODEL=
SANDBOX_ENABLED=false

# Only automated tests use this separate, disposable PostgreSQL database.
TEST_DATABASE_URL=
