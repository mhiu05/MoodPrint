APP_ENV=development
# Copy the PostgreSQL URL from Supabase Connect. Runtime must not be a superuser.
DATABASE_URL=
# Direct or session pooler; never use transaction pooler for Alembic.
DATABASE_MIGRATION_URL=
DATABASE_POOL_MODE=session
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
FRONTEND_ORIGIN=http://127.0.0.1:5173
COOKIE_SECURE=false
OPENAI_API_KEY=
OPENAI_MODEL=
# Requires a reviewed provider retention policy before allowing private data.
AI_ENABLED=false
# Development only: JSON array of internal application user IDs. Normal auth/consent still apply.
AI_LOCAL_TEST_USER_IDS=[]
# Enable only after 0006_ai_usage is applied to the selected database.
AI_ACCOUNTING_ENABLED=false
STT_ENABLED=false
STT_MODEL=gpt-transcribe
SANDBOX_ENABLED=false

# Matching scorer: v1 | v2 | shadow. Keep v1 until the offline gate passes
# (docs/productization/evidence/matching-gate.md); shadow logs aggregate overlap only.
MATCHING_SCORER=v1
# Shared activities (Icebreaker, Cooperative Quiz, Focus). Off until 0013 is applied.
ACTIVITIES_ENABLED=false
# Per-kind rollout/rollback: remove a kind to hide it.
ACTIVITY_KINDS=["icebreaker","coop_quiz","focus"]
# Staff moderation queue (/admin/reports). Grant roles only through reviewed SQL.
MODERATION_ADMIN_ENABLED=false
# AI cost protection: turns per user per Asia/Bangkok day, and a global daily estimated
# spend ceiling in USD (0 = off; requires AI_ACCOUNTING_ENABLED=true).
AI_DAILY_TURNS_PER_USER=60
AI_DAILY_BUDGET_USD=0
# Guest trial, feedback and tour rollout. Every flag is off by default. Turning entry off never
# disables guest expiry, cleanup, orphan reconciliation or spend settlement.
GUEST_AUTH_ENABLED=false
GUEST_PAID_ENABLED=false
GUEST_SEMANTIC_ENABLED=false
FEEDBACK_ENABLED=false
FEEDBACK_ADMIN_ENABLED=false
PRODUCT_TOUR_ENABLED=false
# Feedback collection also needs GUEST_ABUSE_HMAC_KEY (it keys the rate counters); without it the
# endpoints do not exist. RELEASE_VERSION (<= 64 chars: letters, digits . _ + -) is stamped on each
# feedback row by the server; a client can never supply it.
RELEASE_VERSION=unknown
# Paid guest AI/voice/embedding needs an owner-approved positive daily budget (USD) and known
# prices; unset or zero keeps paid guest work closed. No value is approved yet (decision D02).
GUEST_DAILY_BUDGET_USD=
GUEST_PRICING_JSON={}
# At least 32 random characters, set only as a secret in the real environment; never committed.
GUEST_ABUSE_HMAC_KEY=
# Public site key of the CAPTCHA configured in the Auth provider; required before guest entry.
GUEST_CAPTCHA_SITE_KEY=
GUEST_AI_TURNS=25
GUEST_AI_PER_MINUTE=6
GUEST_AI_CONCURRENCY=1
GUEST_AI_GLOBAL_CONCURRENCY=10
GUEST_VOICE_CLIPS=6
GUEST_VOICE_SECONDS=180
GUEST_VOICE_PER_MINUTE=2
GUEST_VOICE_CONCURRENCY=1
GUEST_VOICE_GLOBAL_CONCURRENCY=3

# Only automated tests use this separate, disposable PostgreSQL database.
TEST_DATABASE_URL=

# Apply the reviewed 0007-0009 migrations before running the updated backend.
# Capability does not opt users in. Per-user history and external processing default OFF.
CHAT_HISTORY_ENABLED=true
# 1-4 chat bubbles per reply; keep off until Gate G1a is approved.
AI_MULTI_MESSAGE_ENABLED=false
# Scheduled check-ins: API/UI flag, then the separate `proactive` worker service only.
PROACTIVE_ENABLED=false
PROACTIVE_WORKER_ENABLED=false
PROACTIVE_WORKER_CONCURRENCY=1
PROACTIVE_DAILY_CAP_PER_USER=4
PROACTIVE_BUDGET_SHARE=0.5
PROACTIVE_GRACE_MINUTES=90
PROACTIVE_MAX_ATTEMPTS=3
PROACTIVE_INACTIVE_DAYS=14
PROACTIVE_ROLLOUT_USER_IDS=[]
CHAT_RETENTION_DAYS=30
AI_GLOBAL_CONCURRENCY=50
AI_USER_CONCURRENCY=2
AI_REQUESTS_PER_MINUTE=20
AI_TIMEOUT_SECONDS=30
# One process: 5 + 2. Two overlapping processes use 14 of the role limit 20.
DATABASE_POOL_SIZE=5
DATABASE_POOL_OVERFLOW=2
DATABASE_POOL_TIMEOUT=10
# Backend only. Enable after supplying the credential through local secret configuration.
SEMANTIC_MEMORY_ENABLED=false
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-4-lite
VOYAGE_DIMENSIONS=1024
VOYAGE_TIMEOUT_SECONDS=10
EMBEDDING_JOB_BATCH_SIZE=10
EMBEDDING_MAX_ATTEMPTS=4
EMBEDDING_LEASE_SECONDS=60
MEMORY_RETRIEVAL_LIMIT=6
MEMORY_FALLBACK_LIMIT=100
MEMORY_SIMILARITY_THRESHOLD=0.3
MEMORY_CONTEXT_CHAR_LIMIT=1200
# Optional journal media: server-only Supabase service-role credential, never a VITE_ variable.
# Provision the PRIVATE journal-media bucket with deploy/supabase/journal-media.sql first.
JOURNAL_STORAGE_KEY=
