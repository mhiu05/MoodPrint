{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Proposed blind Vietnamese urgency annotation record (not populated independent evidence)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "cluster_id": {
      "type": "string",
      "minLength": 1
    },
    "split": {
      "enum": [
        "calibration",
        "dev",
        "sealed_test"
      ]
    },
    "age_band": {
      "enum": [
        "11-13",
        "14-17",
        "18",
        "unknown"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "independent_human_synthetic",
            "licensed_external",
            "implementation_synthetic"
          ]
        },
        "source_locator": {
          "type": "string",
          "minLength": 1
        },
        "access_basis": {
          "type": "string",
          "minLength": 1
        },
        "license_or_agreement": {
          "type": "string",
          "minLength": 1
        },
        "independence_evidence": {
          "type": "string",
          "minLength": 1
        },
        "redaction_reviewed": {
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "source_locator",
        "access_basis",
        "license_or_agreement",
        "independence_evidence",
        "redaction_reviewed"
      ]
    },
    "language_style": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "standard_vi",
          "no_diacritics",
          "teen_slang",
          "mixed_language",
          "multi_turn",
          "other"
        ]
      }
    },
    "student_messages_oldest_first": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "label": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "urgency": {
          "enum": [
            "none",
            "elevated",
            "immediate"
          ]
        },
        "primary_group": {
          "enum": [
            "self_harm",
            "third_party",
            "threat",
            "physical",
            "violence",
            "image_coercion",
            "abuse",
            "bullying_distress",
            "benign",
            "ambiguous"
          ]
        },
        "temporality": {
          "enum": [
            "present",
            "imminent",
            "past",
            "resolved",
            "unclear"
          ]
        },
        "subject": {
          "enum": [
            "self",
            "third_party",
            "unclear"
          ]
        },
        "confidence": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "message_index": {
                "type": "integer",
                "minimum": 0,
                "maximum": 3
              },
              "span": {
                "type": "string",
                "minLength": 1
              },
              "rationale": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "message_index",
              "span",
              "rationale"
            ]
          }
        },
        "clarification_needed": {
          "type": "boolean"
        },
        "clarifying_question": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "urgency",
        "primary_group",
        "temporality",
        "subject",
        "confidence",
        "evidence",
        "clarification_needed",
        "clarifying_question"
      ]
    },
    "annotation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "annotator_id": {
          "type": "string",
          "minLength": 1
        },
        "guidelines_version": {
          "type": "string",
          "minLength": 1
        },
        "annotated_at": {
          "type": "string",
          "format": "date-time"
        },
        "blind_to_predictions": {
          "type": "boolean"
        },
        "independent_from_implementation": {
          "type": "boolean"
        },
        "adjudication_status": {
          "enum": [
            "individual",
            "agreed",
            "adjudicated",
            "unresolved"
          ]
        },
        "adjudicator_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "adjudication_reason": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "annotator_id",
        "guidelines_version",
        "annotated_at",
        "blind_to_predictions",
        "independent_from_implementation",
        "adjudication_status",
        "adjudicator_id",
        "adjudication_reason"
      ]
    }
  },
  "required": [
    "schema_version",
    "case_id",
    "cluster_id",
    "split",
    "age_band",
    "source",
    "language_style",
    "student_messages_oldest_first",
    "label",
    "annotation"
  ]
}
