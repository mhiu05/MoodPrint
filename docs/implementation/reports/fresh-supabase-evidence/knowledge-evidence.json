            },
            {
              "chunkId": "kb-evid-dieu-khong-nen#001-cc64b28f",
              "text": "Đừng chỉnh bản chụp, đừng nhờ bạn nhắn tin để \"bẫy\" người kia nói điều xấu. Bằng chứng càng nguyên vẹn thì càng đáng tin.",
              "score": 0.9807692307692308,
              "matchKind": "hybrid",
              "citation": {
                "sourceId": "mp-authored",
                "documentId": "kb-evid-dieu-khong-nen",
                "title": "Khi giữ bằng chứng, những điều không nên làm",
                "publisher": "MoodPrint biên soạn — dựa trên MoodPrint",
                "url": null,
                "section": "Không sửa, không dàn dựng",
                "publishedAt": null,
                "lastReviewed": "2026-11-09",
                "applicability": "Thẻ biên soạn của MoodPrint cho học sinh tại Việt Nam; không thay thế tư vấn pháp lý, y tế hoặc tâm lý.",
                "countryScope": [
                  "VN"
                ]
              }
            },
            {
              "chunkId": "kb-evid-chup-man-hinh#000-774c6c9f",
              "text": "Một bản chụp tốt có đủ bốn thứ: tên hoặc tên tài khoản của người gửi, nội dung, ngày giờ, và những dòng trước sau để thấy ngữ cảnh. Một dòng chữ cắt riêng lẻ dễ bị nghi ngờ hoặc bị hiểu sai. Hãy chụp từ đầu cuộc trò chuyện ngược xuống khi có thể. Giữ nguyên bản. Không cắt, không tô, không chỉnh sửa ảnh. Nếu cần che thông tin để chia sẻ, hãy làm bản sao và giữ bản gốc. Lưu cả bản chụp lẫn đường dẫn của bài đăng hoặc hồ sơ. Kiểm tra giờ trên máy của bạn đã đúng chưa, vì ngày giờ ở bản chụp phụ thuộc vào đó. Đặt tên và cất giữ. Đặt tên tệp theo ngày, ví dụ \"2026-11-03-tin-nhan-ban-A\". Lưu vào một thư mục riêng và gửi một bản cho người lớn bạn tin hoặc lưu vào chỗ không bị người khác truy cập. Thêm một dòng ghi chú: đây là gì, ở ứng dụng nào, bạn nhận lúc nào.",
              "score": 0.9622641509433962,
