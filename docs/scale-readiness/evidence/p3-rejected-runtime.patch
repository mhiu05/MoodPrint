+@pytest.mark.postgres
+async def test_monitor_rejects_conversation_expiring_while_waiting_for_checkout(clients):
+    from datetime import timedelta
+    from uuid import uuid4
+
+    from sqlalchemy.ext.asyncio import async_sessionmaker, create_async_engine
+
+    from app.ai.models import AiConversation
+    from app.ai.policy_monitor import check_policy_snapshot
+    from app.core.errors import DomainError
+    from app.infrastructure.database.models import now
+
+    app, actors = clients
+    client = actors[0][0]
+    model = make_test_model("Synthetic reply")
+    model.hold = True
+    app.state.ai.model_override = model
+    await enable(client)
+    created = await client.post("/api/v1/ai/conversations", headers=key(), json={"botId": "may", "persistent": True})
+    cid = UUID(created.json()["conversationId"])
+    accepted = await client.post(f"/api/v1/ai/conversations/{cid}/messages", headers=key(), json={
+        "text": "Synthetic", "clientMessageId": str(uuid4()), "expectedConversationVersion": 1,
+    })
+    run = app.state.ai.runs[UUID(accepted.json()["runId"])]
+    await asyncio.wait_for(model.started.wait(), 5)
+    engine = create_async_engine(app.state.database.engine.url, pool_size=1, max_overflow=0)
+    sessions = async_sessionmaker(engine, expire_on_commit=False)
+    task = None
+    try:
+        started = asyncio.get_running_loop().create_future()
+
+        async def read():
+            async with sessions() as db:
+                started.set_result(now())
+                await check_policy_snapshot(db, run, app.state.ai.worker_id, accounting=False)
+
+        async with engine.connect():
+            # Open the blocker before setting expiry; connection startup must
+            # not consume the interval and accidentally make the old code pass.
+            async with app.state.database.sessions.begin() as db:
+                expiry = now() + timedelta(seconds=1)
+                (await db.get(AiConversation, cid)).expires_at = expiry
+            task = asyncio.create_task(read())
+            assert await asyncio.wait_for(started, 5) < expiry
+            async with asyncio.timeout(5):
+                while True:
+                    async with app.state.database.sessions() as db:
+                        if await db.scalar(text("select clock_timestamp() >= :expiry"), {"expiry": expiry}):
+                            break
+                    await asyncio.sleep(0.01)
+            assert not task.done()
+        with pytest.raises(DomainError) as denied:
+            await asyncio.wait_for(task, 5)
+        assert denied.value.code == "CONVERSATION_EXPIRED"
+    finally:
+        if task is not None and not task.done():
+            task.cancel()
+            await asyncio.gather(task, return_exceptions=True)
+        await engine.dispose()
+        model.release.set()
+        await run.task
